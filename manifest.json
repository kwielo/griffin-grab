{
  "manifest_version": 3,
  "name": "Griffin Grab",
  "version": "1.1.8",
  "description": "Copy the current page address to the clipboard. The address stays on this computer.",
  "author": "Krzysztof Wielogórski <contact@wielo.co>",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Griffin Grab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "theme_icons": [
      {
        "light": "icons/icon16.png",
        "dark": "icons/dark16.png",
        "size": 16
      },
      {
        "light": "icons/icon32.png",
        "dark": "icons/dark32.png",
        "size": 32
      },
      {
        "light": "icons/icon48.png",
        "dark": "icons/dark48.png",
        "size": 48
      },
      {
        "light": "icons/icon128.png",
        "dark": "icons/dark128.png",
        "size": 128
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "copy-page-address": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "MacCtrl+Command+C"
      },
      "description": "Copy the current page address"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
